{
  "name": "pranpriya-admin-desktop",
  "version": "1.0.0",
  "description": "โปรแกรมเดสก์ท็อปสำหรับเปิดเว็บแอดมินปราณปรียากรุ๊ป (ครอบเว็บแอดมินเดิมไว้ในหน้าต่างโปรแกรม)",
  "main": "main.js",
  "author": "Pranpriya Group",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "th.pranpriya.admindesktop",
    "productName": "ปราณปรียา แอดมิน",
    "files": [
      "main.js",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ปราณปรียา แอดมิน"
    },
    "directories": {
      "output": "dist-installer"
    }
  }
}
